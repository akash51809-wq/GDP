PORT=3001
NODE_ENV=production
FRONTEND_URL=https://gdp-saux.onrender.com
SESSION_SECRET=generate_a_random_32_character_session_secret
ENCRYPTION_KEY=generate_a_random_32_character_encryption_key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gdp?retryWrites=true&w=majority&appName=gdp
RAILKIT_API_KEY=
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://gdp-saux.onrender.com/api/google/callback
