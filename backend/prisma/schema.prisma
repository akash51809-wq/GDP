generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  ACCOUNTS
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(STAFF)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Party {
  id           String    @id @default(cuid())
  customerName String
  whatsapp     String    @default("")
  email        String    @default("")
  address      String    @default("")
  city         String    @default("")
  partyType    String    @default("Customer")
  status       String    @default("ACTIVE")
  balance      Decimal   @default(0) @db.Decimal(14, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tickets      Ticket[]
  pnrRecords   PnrRecord[]
  payments     Payment[]

  @@index([createdAt])
  @@index([whatsapp])
  @@index([email])
}

model Ticket {
  id           String   @id @default(cuid())
  partyId      String
  partyName    String
  bookingDate  String
  pnr          String
  amount       Decimal  @default(0) @db.Decimal(14, 2)
  qrScanId     String   @default("")
  qrRawText    String   @default("")
  qrType       String   @default("")
  qrParsedData Json?
  status       String   @default("BOOKED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  party        Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([partyId])
  @@index([createdAt])
  @@index([qrScanId])
}

model Payment {
  id        String   @id @default(cuid())
  partyId   String
  partyName String
  date      String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  party     Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([partyId])
  @@index([createdAt])
}

model PnrRecord {
  id                  String    @id @default(cuid())
  pnr                 String    @unique
  partyId             String?
  trainNumber         String?
  trainName           String?
  train               Json?
  journey             Json?
  booking             Json?
  chart               Json?
  journeyDateText     String?
  sourceCode          String?
  sourceName          String?
  destinationCode     String?
  destinationName     String?
  boardingCode        String?
  boardingName        String?
  travelClass         String?
  quota               String?
  chartStatus         String?
  fare                Decimal?  @db.Decimal(14, 2)
  passengerCount      Int       @default(0)
  passengers          Json?
  rawData             Json
  fetchedAt           DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  party               Party?    @relation(fields: [partyId], references: [id], onDelete: SetNull)

  @@index([partyId])
  @@index([fetchedAt])
}

model Settings {
  id                 String    @id @default(cuid())
  key                String    @unique @default("global")
  whatsappUrl        String    @default("")
  whatsappToken      String    @default("")
  whatsappSender     String    @default("")
  whatsappEnabled    Boolean   @default(true)
  smtpHost           String    @default("")
  smtpPort           String    @default("587")
  smtpUser           String    @default("")
  smtpPassword       String    @default("")
  smtpFromName       String    @default("RailDesk")
  smtpFromEmail      String    @default("")
  smtpSecure         Boolean   @default(true)
  companyName        String    @default("RailDesk")
  currency           String    @default("INR")
  timezone           String    @default("Asia/Kolkata")
  dateFormat         String    @default("DD/MM/YYYY")
  phoneCountryCode   String    @default("+91")
  lowBalanceAlert    Boolean   @default(true)
  autoRefresh        Boolean   @default(true)
  googleConnected    Boolean   @default(false)
  googleRefreshToken String    @default("")
  googleConnectedAt  DateTime?
  googleDriveFolderId String   @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model QrScan {
  id            String   @id @default(cuid())
  rawText       String
  qrType        String   @default("TEXT")
  parsedData    Json?
  pnr           String?
  fileName      String   @default("")
  driveFileId   String   @default("")
  driveViewLink String   @default("")
  scannedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([pnr])
  @@index([scannedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}
